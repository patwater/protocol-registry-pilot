{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/patwater/protocol-registry-pilot/schema/protocol-entry.schema.json",
  "title": "Protocol Registry Entry",
  "description": "A single protocol reading submitted to the Protocol Institute registry. Contains metadata, a bicorder diagnostic reading, and provenance information.",
  "type": "object",
  "required": ["metadata", "bicorder", "provenance"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "slug", "description", "standpoint", "lifecycle", "scale"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable protocol name (e.g. 'TCP Three-Way Handshake', 'HOA Annual Meeting')",
          "minLength": 2,
          "maxLength": 120
        },
        "slug": {
          "type": "string",
          "description": "URL-safe identifier, kebab-case, used as the filename (e.g. 'tcp-three-way-handshake')",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "description": "1-3 sentence plain-language description of what this protocol is and does",
          "minLength": 10,
          "maxLength": 600
        },
        "standpoint": {
          "type": "string",
          "description": "Who is the analyst and from what vantage point? (e.g. 'designer', 'long-time participant', 'outsider observer', 'the person the protocol is used against')",
          "minLength": 5,
          "maxLength": 200
        },
        "lifecycle": {
          "type": "string",
          "description": "Current lifecycle stage of the protocol",
          "enum": ["budding", "juvenile", "mature", "dead", "fossilized"]
        },
        "scale": {
          "type": "string",
          "description": "Scope of the protocol's operation",
          "enum": ["systemic", "meso", "atomic"]
        },
        "tags": {
          "type": "array",
          "description": "Optional free-form tags for discoverability (e.g. ['networking', 'governance', 'digital', 'civic'])",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "maxItems": 10
        },
        "related_protocols": {
          "type": "array",
          "description": "Slugs of other protocols in this registry that are related",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "bicorder": {
      "type": "object",
      "description": "The full Protocol Bicorder diagnostic reading (bicorder.ecologies.info)",
      "required": ["date", "pass_type", "gradients", "analysis"],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "description": "ISO 8601 date the reading was conducted (YYYY-MM-DD)",
          "format": "date"
        },
        "pass_type": {
          "type": "string",
          "description": "Whether the full 23-gradient or shortform ~11-gradient pass was used",
          "enum": ["full", "shortform"]
        },
        "gradients": {
          "type": "object",
          "description": "Scored gradients from the bicorder instrument. Key is the left-pole term name. Value is an object with score (1-9) and optional notes.",
          "properties": {
            "explicit": { "$ref": "#/$defs/gradient" },
            "institutional": { "$ref": "#/$defs/gradient" },
            "immutable": { "$ref": "#/$defs/gradient" },
            "monocultural": { "$ref": "#/$defs/gradient" },
            "exclusive": { "$ref": "#/$defs/gradient" },
            "hierarchical": { "$ref": "#/$defs/gradient" },
            "determined": { "$ref": "#/$defs/gradient" },
            "macro": { "$ref": "#/$defs/gradient" },
            "obligatory": { "$ref": "#/$defs/gradient" },
            "symmetric": { "$ref": "#/$defs/gradient" },
            "voluntary": { "$ref": "#/$defs/gradient" },
            "agentic": { "$ref": "#/$defs/gradient" },
            "synchronous": { "$ref": "#/$defs/gradient" },
            "legible": { "$ref": "#/$defs/gradient" },
            "immediate": { "$ref": "#/$defs/gradient" },
            "alive": { "$ref": "#/$defs/gradient" },
            "smooth": { "$ref": "#/$defs/gradient" },
            "pleasant": { "$ref": "#/$defs/gradient" },
            "natural": { "$ref": "#/$defs/gradient" },
            "certain": { "$ref": "#/$defs/gradient" },
            "efficient": { "$ref": "#/$defs/gradient" },
            "exciting": { "$ref": "#/$defs/gradient" },
            "engaging": { "$ref": "#/$defs/gradient" }
          },
          "additionalProperties": false
        },
        "analysis": {
          "type": "object",
          "description": "Computed analysis metrics from the bicorder engine",
          "required": ["hardness", "polarized"],
          "additionalProperties": false,
          "properties": {
            "hardness": {
              "type": "number",
              "description": "Mean of all gradient scores (1=fully soft/left, 9=fully hard/right)",
              "minimum": 1,
              "maximum": 9
            },
            "polarized": {
              "type": "number",
              "description": "Measure of how extreme vs central the readings ran (0=all centrist, 1=fully polarized)",
              "minimum": 0,
              "maximum": 1
            },
            "formal_informal": {
              "type": "number",
              "description": "Heuristic formal/informal score (note: real tool uses LDA on private corpus; this is a reconstruction)",
              "minimum": 0,
              "maximum": 1
            },
            "usefulness": {
              "type": "integer",
              "description": "Analyst's judgment: how useful/revealing was the bicorder for this protocol? (1-9)",
              "minimum": 1,
              "maximum": 9
            },
            "usefulness_notes": {
              "type": "string",
              "description": "Analyst's qualitative notes on usefulness rating",
              "maxLength": 400
            },
            "summary_bar": {
              "type": "string",
              "description": "ASCII gradient bar summary generated by the bicorder engine"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Who submitted this reading and how it was verified",
      "required": ["submitted_by", "submission_method", "verified_by"],
      "additionalProperties": false,
      "properties": {
        "submitted_by": {
          "type": "string",
          "description": "GitHub username of the submitter (or 'anonymous')",
          "maxLength": 80
        },
        "submission_method": {
          "type": "string",
          "description": "How the reading was conducted and submitted",
          "enum": ["llm-assisted", "manual", "batch-script"]
        },
        "llm_model": {
          "type": "string",
          "description": "If llm-assisted, which model conducted the interview (e.g. 'claude-sonnet-4-6')",
          "maxLength": 80
        },
        "verified_by": {
          "type": "string",
          "description": "GitHub username of human reviewer who approved this reading, or 'auto' if merged without human review checkbox",
          "maxLength": 80
        },
        "verification_date": {
          "type": "string",
          "description": "ISO 8601 date of verification (YYYY-MM-DD)",
          "format": "date"
        },
        "notes": {
          "type": "string",
          "description": "Any additional provenance notes",
          "maxLength": 400
        }
      }
    }
  },
  "$defs": {
    "gradient": {
      "type": "object",
      "required": ["score"],
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "integer",
          "description": "1 = fully left-pole term, 9 = fully right-pole term, 5 = genuinely mixed",
          "minimum": 1,
          "maximum": 9
        },
        "notes": {
          "type": "string",
          "description": "Analyst's qualitative notes on this gradient reading",
          "maxLength": 300
        }
      }
    }
  }
}
